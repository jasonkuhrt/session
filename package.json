{
  "name": "session-workflow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/session/scripts/session.ts serve",
    "build": "bun run app/build.ts",
    "check": "bun run lint && bun run doctor && bun run build",
    "install:skill": "bash install.sh",
    "lint": "oxlint .",
    "doctor": "react-doctor . --lint --scope full --blocking error --yes --no-score",
    "check:types": "effect-tsgo patch && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@effect/platform-node": "4.0.0-rc.115",
    "@fontsource-variable/geist": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "effect": "4.0.0-rc.115",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "oxlint": "1.79.0",
    "react-doctor": "0.9.13",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.1.0-dev.20260909.1"
  }
}

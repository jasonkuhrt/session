{
  "name": "session-workflow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/session/scripts/session.ts open",
    "build": "rm -rf app/dist && bun --bun vite build --config app/vite.config.ts",
    "check": "bun run lint && bun run doctor && bun run build",
    "install:skill": "bash install.sh",
    "lint": "oxlint .",
    "doctor": "react-doctor . --lint --scope full --blocking error --yes --no-score",
    "check:types": "effect-tsgo patch && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@effect/platform-node": "4.0.0-rc.117",
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "effect": "4.0.0-rc.117",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.85.0",
    "react-doctor": "0.9.14",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.1.0-dev.20260909.1",
    "vite": "8.3.1"
  }
}

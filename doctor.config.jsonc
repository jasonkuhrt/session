{
  "$schema": "https://react.doctor/schema/config.json",
  "lint": true,
  "scope": "full",
  "blocking": "error",
  "warnings": true,
  "noScore": true,
  "ignore": {
    "overrides": [
      {
        // Stock shadcn toggle groups construct a tiny provider value so their
        // compound children share size and variant styling.
        "files": ["app/src/components/ui/toggle-group.tsx"],
        "rules": ["react-doctor/jsx-no-constructed-context-values"]
      },
      {
        // The stock shadcn breadcrumb marks its current page with a span that
        // carries `role="link"` and `aria-current`, because the page is not a
        // destination to navigate to. The generated primitives are kept as
        // generated.
        "files": ["app/src/components/ui/breadcrumb.tsx"],
        "rules": ["react-doctor/prefer-tag-over-role"]
      },
      {
        // `session open` posts its own worktree path to its own daemon over
        // loopback. The daemon tracks a path only after seeing that it is a
        // directory, and serves nothing beyond the boards it already owns.
        "files": ["app/server/daemon.ts"],
        "rules": ["react-doctor/local-rpc-native-bridge-risk"]
      }
    ]
  },
  "categories": {
    "Security": "error",
    "Bugs": "error",
    "Performance": "error",
    "Accessibility": "error",
    "Maintainability": "error"
  },
  "buckets": {
    // Conditional React Compiler cleanup diagnostics are warnings by default.
    // If that bucket becomes active, it follows the same error-only contract.
    "compiler-cleanup": "error"
  },
  "rules": {
    // Project-graph rules are opt-in in React Doctor, so keep each one
    // explicit rather than relying on a future change to its default set.
    "react-doctor/circular-dependency": "error",
    "react-doctor/unused-dependency": "error",
    "react-doctor/unused-dev-dependency": "error",
    // React Doctor 0.9.14 never checks an entry's exports. Its entries here are
    // what tsconfig.json's `files` names, every file a package script runs,
    // and all that file imports, which is the CLI and everything it reaches.
    // So the export rules check the board's modules and nothing the CLI
    // imports.
    "react-doctor/unused-export": "error",
    "react-doctor/unused-type": "error",
    // React Doctor 0.9.14 reports an unreachable file only in a package whose
    // graph it has verified, and it verifies one only from entry patterns that
    // neither its config nor its command line can set, or from a Create React
    // App or Next.js entry. A TanStack Start app never passes, so the rule
    // cannot fire here whatever the entries are.
    "react-doctor/unused-file": "off"
  },
  "surfaces": {
    "ciFailure": {
      // React Doctor normally keeps design findings advisory. This project
      // intentionally makes every enabled rule part of the CI contract.
      "includeCategories": [
        "Security",
        "Bugs",
        "Performance",
        "Accessibility",
        "Maintainability"
      ]
    }
  }
}
